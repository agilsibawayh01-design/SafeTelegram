<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No other permissions are requested. In particular:
      - No RECEIVE_BOOT_COMPLETED: removed along with BootReceiver — the
        system re-binds enabled accessibility services automatically after
        boot, so this permission had zero function and only added to the
        app's risk signature (BOOT_COMPLETED + AccessibilityService is a
        well-known persistence pattern that security scanners flag).
      - No FOREGROUND_SERVICE: this app has no foreground/background Service,
        only an AccessibilityService (a different component type, bound by
        the system itself — it does not need this permission).
      - No INTERNET, no storage, no overlay permissions: this app makes no
        network calls, stores no files, and draws no overlays.
    -->

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SafeTelegram"
        android:supportsRtl="true">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          android:exported="true" is required by the framework for
          AccessibilityService (the system must be able to bind to it), and
          is safe despite being exported: the BIND_ACCESSIBILITY_SERVICE
          permission below is a signature|system-level permission that only
          the OS itself holds, so no third-party app can bind to this
          service directly.
        -->
        <service
            android:name=".service.TelegramGuardService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
